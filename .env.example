# Credential and override reference. Real values never go in the repo, a unit
# file, or git history. Every value below is a placeholder.
#
# `bin/curated-digest init` writes each "--- ...: <file>.env ---" block below to
# its own file in the config home (~/.config/curated-digest/ by default) with
# mode 0600. Fill the values in with an editor; never paste them into a chat.

# --- Telegram delivery: ~/.config/curated-digest/telegram.env ---
# Create a bot with @BotFather, then message it once and read the chat id from
# the getUpdates response.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

# --- Gemini provider (for gemini: models): ~/.config/curated-digest/gemini.env ---
# Use a key scoped to this pipeline only, not one shared with other tools (D20).
GEMINI_API_KEY=replace-me

# --- Reddit source (for reddit sources): ~/.config/curated-digest/reddit.env ---
# App-only OAuth credentials from a "script" app at reddit.com/prefs/apps.
REDDIT_CLIENT_ID=replace-me
REDDIT_CLIENT_SECRET=replace-me
REDDIT_USER_AGENT=linux:curated-digest:1.0 (by /u/replace-me)

# --- Watchdog: ~/.config/curated-digest/curated-digest.env ---
# A dead-man's-switch URL from any service that alerts when pings stop. Pinged
# only on a clean tick, so you are alerted by a different route when pings stop.
CURATED_DIGEST_HC_PING_URL=https://hc-ping.example.invalid/replace-me

# --- Optional path and behaviour overrides (all have working defaults) ---
# CURATED_DIGEST_HOME=~/.config/curated-digest   # config home: tasks/, *.env, voice.md
# CURATED_DIGEST_TASKS_DIR=$CURATED_DIGEST_HOME/tasks
# CURATED_DIGEST_STATE_DIR=~/.local/state/curated-digest   # ledger, pause flag, store
# CURATED_DIGEST_CONFIG=./config/harness.yaml     # rate-limit signatures, retry caps, spend
# CURATED_DIGEST_EDITORIAL_FILE=$CURATED_DIGEST_HOME/voice.md
# CURATED_DIGEST_TELEGRAM_ENV=$CURATED_DIGEST_HOME/telegram.env
# CURATED_DIGEST_GEMINI_KEY_FILE=$CURATED_DIGEST_HOME/gemini.env
# CURATED_DIGEST_REDDIT_ENV=$CURATED_DIGEST_HOME/reddit.env
# CURATED_DIGEST_ENV=$CURATED_DIGEST_HOME/curated-digest.env
# CURATED_DIGEST_BACKUP_DEST=~/.local/state/curated-digest-backups
# CURATED_DIGEST_BACKUP_KEEP=14
# CURATED_DIGEST_SPEND_CEILING_USD=10         # set by the runner from harness.yaml

# --- Build tooling only (tools/build-loop/; not needed to run a digest) ---
# CURATED_DIGEST_BUILD_MODEL=                 # model for the headless build loop
# CURATED_DIGEST_BUILD_SLIM=0                 # 1 = slim system prompt (tools/PLAYBOOK.md L1)
# CURATED_DIGEST_QUEUE=tools/build-loop/NEXT.md

# --- verify.sh opt-ins for live-host checks (skipped when unset) ---
# CLAUDE_CONFINE_HOOK=/path/to/your/pretooluse-confine-hook.sh
# CURATED_DIGEST_REQUIRE_LIVE=1               # make skipped live checks fail
