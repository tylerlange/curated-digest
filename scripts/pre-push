#!/usr/bin/env bash
# git pre-push hook: refuse to push while the identifier scan has hits.
# Install with `make hooks`. Bypass once with `git push --no-verify` only if
# you have read every hit and know it is safe.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
if ! python3 "$root/scripts/scan_identifiers.py" "$root"; then
  echo "pre-push: identifier scan failed; nothing was pushed." >&2
  exit 1
fi
